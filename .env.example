# Copie para .env (que NÃO é versionado) e preencha. Gere senhas fortes, ex.: openssl rand -base64 24
# Superusuário do container: só para o setup inicial e manutenção; a API nunca usa.
POSTGRES_PASSWORD=

# Usuário de migração (dono do schema chefhome): só o passo `docker compose run --rm migracao`.
CHEFHOME_SENHA_MIGRACAO=
# Usuário da API (só SELECT/INSERT/UPDATE/DELETE): vai em DATABASE_PASSWORD da aplicação.
CHEFHOME_SENHA_APP=
# Porta no host (127.0.0.1). 5433 para não conflitar com um Postgres instalado na máquina.
CHEFHOME_PORTA=5433

# Da API (o compose não usa): segredo do hash dos telefones banidos (openssl rand -base64 32; em prod, 32+ caracteres).
# A verificação de telefone está parada até a escolha do canal; o pepper só é usado quando um provedor for ligado.
CHEFHOME_PEPPER_TELEFONE=
# só em desenvolvimento: true liga a verificação falsa (código 000000) para testar o fluxo. Nunca em prod.
CHEFHOME_TELEFONE_FALSO=
